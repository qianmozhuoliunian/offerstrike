# Copy to .env. All services are optional; keep unused values empty.
# Never commit .env or put real keys in this template.
# Search: configure at least one provider to enable web search.
TAVILY_API_KEY=
EXA_API_KEY=

# AI: configure both key and model. Use your provider's base URL,
# without /chat/completions. An empty base URL uses the default provider.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Legacy Node entry only. Native FastAPI uses providers directly and ignores these.
# See research_service/README.md before enabling.
RESEARCH_SERVICE_URL=
RESEARCH_SERVICE_TOKEN=

# Optional evidence pilot. Comma-separated CNBlogs article URLs cleared for the intended use.
# Select 博客园 in 深度研究 to run the pilot against those articles.
RESEARCH_PILOT_URLS=

# Optional local data directory. Empty uses the documented OS default.
INTERVIEW_DATA_DIR=
