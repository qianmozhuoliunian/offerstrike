{
  "name": "offerstrike",
  "version": "0.1.0",
  "private": true,
  "description": "面试突击 · OfferStrike",
  "author": "OfferStrike contributors",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "npm run vue:build && node scripts/start-workbench.mjs",
    "start:legacy": "node --env-file-if-exists=.env server.js",
    "vue:build": "vite build --config frontend/vite.config.js",
    "fastapi:start": ".venv/Scripts/python.exe -m backend.run",
    "fastapi:test": ".venv/Scripts/python.exe -m pytest -q backend/tests",
    "vue:test-ui": "electron scripts/check-vue-ui.cjs",
    "desktop:test": "node scripts/check-native-desktop.mjs",
    "test": "node scripts/test.mjs",
    "release:check": "node scripts/check-release.mjs",
    "check": "npm test && npm run release:check && npm run demo:build",
    "demo:build": "node scripts/build-demo.mjs",
    "demo:preview": "node scripts/build-demo.mjs && node scripts/preview-demo.mjs",
    "desktop": "npm run vue:build && electron .",
    "backend:build": "node scripts/build-backend.mjs",
    "desktop:build": "npm run vue:build && npm run backend:build && electron-builder --win --x64"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "parse5": "8.0.1",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.8"
  }
}
